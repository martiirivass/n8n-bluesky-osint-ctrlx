      ],
      "id": "32990031-1ead-4b99-b93f-9c0969f008d0",
      "name": "Fuente dominante"
    },
    {
      "parameters": {
        "jsCode": "let maxScore = -1;\nlet topPost = null;\nfor (const item of items) {\n  const score = item.json.engagement_score;\n  if (score > maxScore) {\n    maxScore = score;\n    topPost = item.json;\n  }\n}\nreturn [\n  {\n    json: {\n      texto: topPost.texto,\n      autor: topPost.autor_handle,\n      fuente_dominio: topPost.fuente_dominio,\n      engagement_score: topPost.engagement_score,\n      likes: topPost.likes,\n      reposts: topPost.reposts,\n      replies: topPost.replies,\n      post_uri: topPost.post_uri\n    }\n  }\n];"
      },
